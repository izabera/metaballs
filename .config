NTHR=${NTHR-8}

# jemalloc usually makes bash go faster than the glibc malloc
for jemalloc in /usr/lib{,64,/{aarch64,x86_64}-linux-gnu}/libjemalloc.so; do
    [[ -e $jemalloc ]] && [[ ! $LD_PRELOAD = *$jemalloc* ]] && {
        LD_PRELOAD+=${LD_PRELOAD:+:}$jemalloc
        export LD_PRELOAD
        break
    }
done
