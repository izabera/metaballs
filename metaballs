die () { diemsg=$*; exit 1; }

resetterm () {
    local escapes=(
        '\e[m'      # sgr state
        '\e[?25h'   # show cursor
        '\e8'       # restore cursor pos
        '\e[?1049l' # alt screen off
        '\e[?1000l' # mouse mode
        '\e[?1006l' # sgr mouse mode idk whatever
        '\e[?1002l' # mouse button even tracking
        '\e[?1016l' # mouse returns pixels
        '\e8'       # restore cursor pos
    )
    printf %b "${escapes[@]}"
    stty sane
}
exitfunc () {
    resetterm
    [[ $diemsg ]] && echo "$diemsg"
    balltimes
    dispatch exit
}

balltimes () {
    sorted=() sum=0 counted=()
    ((${#balltimes[@]})) || return
    for n in "${balltimes[@]}"; do
        ((sum += n))
        ((counted[n]++))
    done
    for n in "${!counted[@]}"; do
        for ((i=0; i<counted[n]; i++)) do
            sorted+=("$n")
        done
    done

    min=${sorted[0]} max=${sorted[-1]}
    ballcount=${#sorted[@]}
    mean=$((sum/ballcount))
    sum=0 sqdiffs=()
    for i in "${!sorted[@]}"; do
        ((sum+=(sqdiffs[i]=(sorted[i]-mean)**2)))
    done
    variance=$((sum/ballcount))

    # newton's method
    x=$((variance/2))
    while ((x)); do
        ((prev=x,x=(x+variance/x)/2,x==prev)) && break
    done
    stddev=$x

    echo 'metaball count' "$ballcount"
    printf "fastest metaball %'dµs\n" "$min"
    printf "slowest metaball %'dµs\n" "$max"
    printf "average metaball %'dµs\n" "$mean"
    printf "95th %%ile %'dµs\n" "${sorted[ballcount*95/100]}"
    printf "std dev %'dµs\n" "$stddev"
    echo 'sizes' "colw=$colw rowh=$rowh winh=$winh winw=$winw"
}


