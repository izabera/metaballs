mouseregex=$'^\e\[<([0-9]+);([-0-9]+);([-0-9]+)([mM])(.*)' # can be negative!!!
getinput () {
    local input
    while read -rn1; do
        input+=$REPLY
        case $input in
            $'\e[<'+([-0-9;])[mM])
                [[ $input =~ $mouseregex ]]
                input=${BASH_REMATCH[-1]}
                BUTTON=("${BASH_REMATCH[@]:1:4}")
                # yes of course we must swap the height and width every time
                # otherwise this api would be too simple to use
                (( BUTTON[1] < 0 || BUTTON[1] >= winw )) && continue
                (( BUTTON[2] < 0 || BUTTON[2] >= winh )) && continue
                return
                ;;
            # csi/ss3 arrows | non csi escape | weird csi
            $'\e'[[O][ABCD]  | $'\e'[^[]      | $'\e['*([0-?])*([ -/])[@-~]) input= ;;
            $'\e'*) ;; # incomplete csi
            *) input= ;; # weird keyboard input?
        esac
    done
}

getmouse () {
    getinput

    ((
      col   = BUTTON[1] / colw + 1,
      row   = BUTTON[2] / rowh + 1,
      hilo  = (BUTTON[2] % rowh) > hrow,
      hirow = row * 2,
      lorow = row * 2 + 1,
      subrow = row * 2 + hilo
    ))
}

