declare -A states=()

winmin=$((winpx[0]<winpx[1]?winpx[0]:winpx[1]))

# the standard wyvill 6th degree polynomial:
# f(d) = (1 - (d/R)^2)^3   if d <= R, else 0
# it's C^2 continuous, and it has compact support, so there is no effect after R^2
# we can thus add each ball independently

# to evaluate it in fixed point maths, pick a scale so that we never overflow
scale=$((1<<16))

# for now all our balls will have the same radius
 R=$((scale*winmin/5))
R2=$((scale*winmin**2/25))
S2=$((scale*scale*winmin**2/25))

wyvill='d2<S2?scale-d2/R2:0'
field='wyvill*wyvill/100/scale*wyvill/scale'

times=()

declare -A f

alpha=({A..Z} {a..z} {0..9})
expr=(
    'y=c*colw*scale'
    'd2=(xdhi+(y-cy)**2),hi=(f[' ']+=field),hi=hi>LO&&hi<HI?255:0'
    'd2=(xdlo+(y-cy)**2),lo=(f[' ']+=field),lo=lo>LO&&lo<HI?255:0'
)
drawball() {
    local d2
    local rhi rlo rmin rmax c cmin cmax
    local cx=$1 cy=$2
    local x y
    local hi lo
    local wh=$(((winh-2)*scale)) ww=$(((winw-2)*scale))

    if (((modes[1016]&1) == 1)); then
        ((rmin = (cx-R>=0?cx-R:0 )/scale/rowh*2))
        ((rmax = (cx+R<wh?cx+R:wh)/scale/rowh*2+1))
        ((cmin = (cy-R>=0?cy-R:0 )/scale/colw))
        ((cmax = (cy+R<ww?cy+R:ww)/scale/colw))
        #echo debug:$tid:mode1016=1,rmin=$rmin,rmax=$rmax >&2

        for ((rhi=rmin;rhi<=rmax;rhi+=2)) do
            ((rhi % NTHR == tid )) || continue
            printf '\e[%s;%sH' "$((rhi/2+1))" "$((cmin+1))"
            ((x=rhi/2*rowh*scale,rlo=rhi+hrow*scale))
            ((xdhi=(x-cx)**2,xdlo=(x+hrow*scale-cx)**2))

            for ((c=cmin;c<=cmax;c++)) do
                ((${expr[0]},${expr[1]}$rhi,$c${expr[2]},${expr[3]}$rlo,$c${expr[4]}))
                printf '\e[38;2;%s;%s;%s;48;2;%s;%s;%sm▀' "$hi" "$hi" "$hi" "$lo" "$lo" "$lo"
            done
        done
    else
        ((cx*=2))
        ((rmin = (cx-R>=0?cx-R:0 )/scale/2))
        ((rmax = (cx+R<wh?cx+R:wh)/scale/2))
        ((cmin = (cy-R>=0?cy-R:0 )/scale/2*2))
        ((cmax = (cy+R<ww?cy+R:ww)/scale/2*2))

        for ((r=rmin;r<=rmax;r++)) do
            ((rhi % NTHR == tid )) || continue
            printf '\e[%s;%sH' "$((r+1))" "$((cmin+1))"
            ((x=r*2*scale,xdhi=(x-cx)**2))

            for ((c=cmin;c<=cmax;c+=2)) do
                ((${expr[0]},${expr[1]}$r,$c${expr[2]}))
                printf '\e[48;2;%s;%s;%sm  ' "$hi" "$hi" "$hi"
            done
        done
    fi
}
run_listeners

while getmouse; do
