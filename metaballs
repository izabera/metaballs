escapes=(
    '\e[?1049h'  # alt screen
    '\e[J'       # erase screen
    '\e[?25l'    # hide cursor
    '\e7'        # save cursor pos
    '\e[?1000h'  # mouse mode
    '\e[?1002h'  # mouse button even tracking
    '\e[?1006h'  # sgr mouse mode idk whatever
    '\e[?1016h'  # mouse returns pixels
    '\e[?1000$p' # query mouse mode
    '\e[?1002$p' # query mouse button even tracking
    '\e[?1006$p' # query sgr mouse mode idk whatever
    '\e[?1016$p' # query mouse returns pixels
    '\e[14t'     # window size in pixels
    '\e[16t'     # cell size in pixels
    '\e[18t'     # term size in cells
    '\e[?6n'     # cursor position just to definitely get a reply
)

initterm () {
    local REPLY
    while read -rn1 -t.01; [[ $REPLY ]]; do :; done

    printf %b "${escapes[@]}"
    read -r -t.1 -d R
    csi=$'\e\['
    qregex=';([^$]+)[$]y' # decrqm replies
    tregex=';([^;]+);([^t]+)t'

    regex=
    regex+="(${csi}[?]1000$qregex)?"
    regex+="(${csi}[?]1002$qregex)?"
    regex+="(${csi}[?]1006$qregex)?"
    regex+="(${csi}[?]1016$qregex)?"
    regex+="(${csi}4$tregex)?"
    regex+="(${csi}6$tregex)?"
    regex+="(${csi}8$tregex)?"

    [[ $REPLY =~ $regex ]]

    modes=(
        [1000]=${BASH_REMATCH[2]}
        [1002]=${BASH_REMATCH[4]}
        [1006]=${BASH_REMATCH[6]}
        [1016]=${BASH_REMATCH[8]}
    )

        winpx=(${BASH_REMATCH[10]} ${BASH_REMATCH[11]})
       cellpx=(${BASH_REMATCH[13]} ${BASH_REMATCH[14]})
    termcells=(${BASH_REMATCH[16]} ${BASH_REMATCH[17]})

    if (((modes[1016]&1) != 1)); then # mouse will not report pixel events
        winpx[0]=$((termcells[0]*2)) winpx[1]=${termcells[1]}
        cellpx=(1 1)
    elif ((!${#cellpx[@]} && ${#winpx[@]} && ${#termcells[@]})); then
        ((cellpx[0]=winpx[0]/termcells[0], cellpx[1]=winpx[1]/termcells[1]))
    fi

    if ((!${#cellpx[@]})); then
        die "could not get cell size :(   reply=${REPLY@Q}"
    fi

    rows=${termcells[0]}
    cols=${termcells[1]}

    winh=${winpx[0]}
    winw=${winpx[1]}
    rowh=${cellpx[0]}
    colw=${cellpx[1]}
    hrow=$((rowh/2)) # halfrow

    printf '\e[48;2;0;0;0m\e[H'
    printf '%*s' "$((termcells[0]*termcells[1]))"
}
initterm

# do not reinit the whole thing on sigwinch
escapes=(
    '\e[?1016h' # mouse returns pixels
    '\e[14t'    # window size in pixels
    '\e[16t'    # cell size in pixels
    '\e[18t'    # term size in cells
)
